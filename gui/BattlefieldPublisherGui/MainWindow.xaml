<Window x:Class="BattlefieldPublisherGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M.A.C.E Publisher"
        Width="900" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="🌸" FontSize="16" FontFamily="Segoe UI Emoji" Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="M.A.C.E" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="PUBLISHER" FontSize="10" Foreground="{StaticResource TextFaintBrush}"
                               VerticalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource ChromeButton}" Click="Minimize_Click" />
                    <Button Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click" Margin="0,0,10,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{StaticResource BorderBrush1}" />

        <!-- Body -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Image Source="Assets/background.png" Stretch="UniformToFill" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C00B0710" Offset="0" />
                        <GradientStop Color="#900B0710" Offset="0.3" />
                        <GradientStop Color="#F00B0710" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="30,26,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="TitleText" Text="Публикация обновления" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="RepoText" Text="Glesooo/battlefield-modpack" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Live log -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14"
                        BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" Padding="4">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBox x:Name="LogText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="Wrap" Padding="14" IsReadOnlyCaretVisible="False" />
                    </ScrollViewer>
                </Border>

                <!-- Status + buttons -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Готов к публикации" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource SecondaryButton}"
                                Click="Cancel_Click" Margin="0,0,10,0" Visibility="Collapsed" />
                        <Button x:Name="ActionButton" Content="Опубликовать" Style="{StaticResource PrimaryButton}"
                                Click="Action_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
