<Application x:Class="MaceLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="HeadFont">Bahnschrift</FontFamily>

            <SolidColorBrush x:Key="BgBrush" Color="#0A0C0F" />
            <SolidColorBrush x:Key="PanelBrush" Color="#0B0E12" Opacity="0.88" />
            <SolidColorBrush x:Key="FieldBrush" Color="#06080A" Opacity="0.9" />
            <SolidColorBrush x:Key="EdgeBrush" Color="#FFA030" Opacity="0.22" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FFA030" />
            <SolidColorBrush x:Key="AccentBrightBrush" Color="#FFC266" />
            <SolidColorBrush x:Key="TextBrush" Color="#F2EEE8" />
            <SolidColorBrush x:Key="TextDimBrush" Color="#A9A39A" />
            <SolidColorBrush x:Key="TextFaintBrush" Color="#6F6A63" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#E5534B" />
            <SolidColorBrush x:Key="OkBrush" Color="#7FCF8A" />

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFB347" Offset="0" />
                <GradientStop Color="#E8871E" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="ChromeButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="34" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#26FFFFFF" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PlayButton" TargetType="Button">
                <Setter Property="Foreground" Value="#1A1006" />
                <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="2" />
                                <Border x:Name="Glow" Background="#33FFFFFF" CornerRadius="2" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Body" Property="Background" Value="#3A342C" />
                                    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NickBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource NickBox}">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="9,0" />
            </Style>

            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            </Style>

            <Style x:Key="SettingHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Body" Background="Transparent" BorderBrush="{StaticResource EdgeBrush}"
                                    BorderThickness="1" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="18" Height="18" Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="2">
                                    <Path x:Name="Mark" Data="M 3,8 L 7,12 L 13,4" Stroke="{StaticResource AccentBrightBrush}"
                                          StrokeThickness="2" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderPart" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Height="22">
                                <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentSlider" TargetType="Slider">
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="IsSnapToTickEnabled" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Track x:Name="PART_Track" Height="22">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderPart}"
                                                  Background="{StaticResource AccentBrush}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderPart}"
                                                  Background="#1FFFFFFF" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="10" Height="22" Background="{StaticResource AccentBrightBrush}"
                                                        CornerRadius="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="6" />
                <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
                <Setter Property="Background" Value="#1FFFFFFF" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" />
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
